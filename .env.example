# deploy/README.md 참고 - 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
# cp .env.example .env
#
# .env는 .gitignore에 의해 git에 올라가지 않습니다 - 배포 서버에는 git으로 이 저장소를
# 받은 뒤, 이 파일만 별도로(scp 등으로, 또는 서버에서 직접 vi/nano로) 작성해야 합니다.

# 기존 AWS RDS(MySQL) 접속 정보
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 충분히 긴 임의의 문자열(로그인 JWT 서명용)
JWT_SECRET_KEY=

# Henrik(비공식 발로란트 API) 키 - 일반 검색/화면용, 승부예측(ML)용 각각
HENRIK_API_KEY=
HENRIK_ML_API_KEY=

# AI 리포트(승부예측/우리팀 분석) 생성에 사용 - 비워두면 폴백 템플릿으로 동작
ANTHROPIC_API_KEY=

# 이 서버를 외부에서 접속할 포트(기본 8080) 및 프론트 접속 주소(CORS 허용 목록)
WEB_PORT=8080
FRONT_ORIGINS=http://서버IP:8080

# 개발용 상세 로그 on/off
PREMIER_KAST_DEBUG=false
